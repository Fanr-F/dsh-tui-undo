{
  "name": "dsh-tui-undo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "examples",
    "README.md",
    "package.json"
  ],
  "description": "Undo / redo for dsh conversations and workspaces, replayed inside a real maintenance turn so the session log always reloads.",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "verify:replay": "node --test --test-isolation=none test/host-format.test.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs"
  }
}
