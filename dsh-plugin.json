{
  "$schema": "https://schemas.dsh.dev/dsh-plugin/0.15.json",
  "manifestVersion": "0.15",
  "id": "dsh.tui-undo",
  "name": "dsh-tui-undo",
  "version": "0.1.0",
  "facets": {
    "host": {
      "entry": "./src/index.mjs",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": []
  },
  "permissions": [],
  "contributes": {
    "commands": [
      {
        "id": "dsh.undo",
        "title": "Undo",
        "description": "Hide the latest turns and restore the worktree to the boundary."
      },
      {
        "id": "dsh.redo",
        "title": "Redo",
        "description": "Bring back one hidden turn, or clear the revert when none remain."
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT"
}
